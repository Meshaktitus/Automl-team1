{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gts:team1:semantic_detection:result:1.0-draft",
  "title": "Semantic Detection Result (one dataset)",
  "description": "Output of run_detection for ONE dataset (run_detection returns a list of these). Target, problem type, feature columns, column roles and leakage check. Status: proposed, pending Team 1 review. Defined in docs/HANDOFF_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset",
    "target",
    "target_source",
    "problem_type",
    "confidence",
    "source",
    "needs_confirmation",
    "evidence",
    "alternatives",
    "warnings",
    "target_confirmed",
    "target_statistics",
    "candidates",
    "semantic_columns",
    "dataset_characteristics",
    "feature_columns",
    "recommended_feature_columns",
    "approved_feature_columns",
    "features_status",
    "column_roles",
    "leakage_checks",
    "status"
  ],
  "properties": {
    "dataset": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_source": {
      "type": "string",
      "enum": [
        "user_override",
        "top_suggestion",
        "none"
      ]
    },
    "problem_type": {
      "type": "string",
      "enum": [
        "binary_classification",
        "multiclass_classification",
        "regression",
        "forecasting",
        "clustering",
        "anomaly_detection",
        "recommendation",
        "review_required"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "user_override",
        "business_goal",
        "data_rules"
      ]
    },
    "needs_confirmation": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "problem_type",
          "reason"
        ],
        "properties": {
          "problem_type": {
            "type": "string",
            "enum": [
              "binary_classification",
              "multiclass_classification",
              "regression",
              "forecasting",
              "clustering",
              "anomaly_detection",
              "recommendation",
              "review_required"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_confirmed": {
      "type": "boolean"
    },
    "target_statistics": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "column",
        "semantic_type",
        "unique_count",
        "missing_count",
        "missing_pct"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "candidate_target",
          "semantic_type",
          "suggested_problem_type",
          "score",
          "confidence_level",
          "priority",
          "quality_issue_codes",
          "blocking_reason"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "candidate_target": {
            "type": "string"
          },
          "semantic_type": {
            "type": "string",
            "enum": [
              "identifier",
              "email",
              "phone",
              "percentage",
              "date",
              "time",
              "boolean_flag",
              "categorical",
              "financial_amount",
              "numerical_measure",
              "text",
              "unknown"
            ]
          },
          "suggested_problem_type": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "confidence_level": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low",
              "User-selected"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "Top suggestion",
              "Alternative",
              "Candidate",
              "User-selected",
              "Blocked by quality"
            ]
          },
          "warnings": {
            "type": "string"
          },
          "quality_issues": {
            "type": "string"
          },
          "quality_issue_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocking_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "semantic_columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "column",
          "semantic_type",
          "confidence",
          "sensitive"
        ],
        "properties": {
          "column": {
            "type": "string"
          },
          "semantic_type": {
            "type": "string",
            "enum": [
              "identifier",
              "email",
              "phone",
              "percentage",
              "date",
              "time",
              "boolean_flag",
              "categorical",
              "financial_amount",
              "numerical_measure",
              "text",
              "unknown"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "dataset_characteristics": {
      "type": "object",
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "column_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "profile_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_column_count": {
          "type": "integer",
          "minimum": 0
        },
        "feature_type_counts": {
          "type": "object",
          "properties": {
            "numerical": {
              "type": "integer"
            },
            "categorical": {
              "type": "integer"
            },
            "boolean": {
              "type": "integer"
            },
            "other": {
              "type": "integer"
            }
          }
        },
        "missing_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "column",
              "missing_count",
              "missing_pct"
            ]
          }
        },
        "time_info": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "column",
              "estimated_frequency",
              "gaps"
            ]
          }
        },
        "time_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identifier_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "feature_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_feature_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_feature_columns": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "features_status": {
      "type": "string",
      "enum": [
        "approved",
        "recommended_pending_confirmation"
      ]
    },
    "column_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "column",
          "semantic_type",
          "data_type",
          "role",
          "reason",
          "unique_values",
          "missing_count",
          "missing_pct",
          "sensitive",
          "needs_privacy_review",
          "time_axis",
          "quality_blocked",
          "quality_issues",
          "quality_issue_codes",
          "preprocessing_hint",
          "leakage_suspect",
          "leakage_correlation"
        ],
        "properties": {
          "column": {
            "type": "string"
          },
          "semantic_type": {
            "type": "string",
            "enum": [
              "identifier",
              "email",
              "phone",
              "percentage",
              "date",
              "time",
              "boolean_flag",
              "categorical",
              "financial_amount",
              "numerical_measure",
              "text",
              "unknown"
            ]
          },
          "data_type": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "target",
              "feature",
              "identifier",
              "date",
              "time",
              "text",
              "excluded"
            ]
          },
          "reason": {
            "type": "string"
          },
          "unique_values": {
            "type": [
              "integer",
              "null"
            ]
          },
          "missing_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "missing_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "sensitive": {
            "type": "boolean"
          },
          "needs_privacy_review": {
            "type": "boolean"
          },
          "time_axis": {
            "type": "boolean"
          },
          "quality_blocked": {
            "type": "boolean"
          },
          "quality_issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_issue_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preprocessing_hint": {
            "type": "string"
          },
          "leakage_suspect": {
            "enum": [
              "possible",
              "strong",
              null
            ]
          },
          "leakage_correlation": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    },
    "leakage_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "thresholds",
        "limits",
        "suspects"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "checked",
            "not_checked",
            "pending_integration"
          ]
        },
        "reason": {
          "type": "string"
        },
        "thresholds": {
          "type": "object",
          "required": [
            "possible",
            "strong"
          ],
          "properties": {
            "possible": {
              "type": "number"
            },
            "strong": {
              "type": "number"
            }
          }
        },
        "limits": {
          "type": "string"
        },
        "suspects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "column",
              "correlation",
              "level",
              "message"
            ],
            "properties": {
              "column": {
                "type": "string"
              },
              "correlation": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "level": {
                "type": "string",
                "enum": [
                  "possible",
                  "strong"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "status": {
      "const": "Proposed, pending verification"
    }
  }
}